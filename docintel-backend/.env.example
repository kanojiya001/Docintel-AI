# DocIntel AI — Environment Variables
# =====================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=DocIntel AI
APP_VERSION=1.0.0
DEBUG=True

# Security (use your Supabase secret key or generate a random 32-char string)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database — Supabase PostgreSQL (Transaction Pooler, port 6543)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Pinecone (Optional — leave blank to use FAISS)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=docintel

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Vector Store
VECTOR_STORE_DIR=vector_store
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
